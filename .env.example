# ─────────────────────────────────────────────────────────────────────────────
# CaiShen environment configuration — copy to .env and fill in real values.
# .env is gitignored; .env.example is committed as documentation. NEVER commit secrets.
#
# Loading model (see server/index.js): .env is loaded first, then .env.local OVERRIDES
# it if present. So:
#   .env        → production-ish defaults (committed-shape on the server: hosted Supabase)
#   .env.local  → your LOCAL dev overrides (gitignored): DATABASE_URL → local Postgres
# See DATABASE_SETUP.md for the full local-vs-hosted workflow.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment + database safety ────────────────────────────────────────────
# core/db.js logs the active DB host on startup (no secrets) and guards production by an
# EXPLICIT host. Set PROD_DB_HOST to your REAL production DB host (e.g. AWS RDS/Aurora);
# then any process with NODE_ENV != production that points at that host REFUSES to start,
# so dev/heavy-testing can never touch production. Hosted Supabase (your build DB) and
# local Postgres (your test DB) are unaffected.
NODE_ENV=development
# PROD_DB_HOST=caishen-prod.xxxx.us-west-2.rds.amazonaws.com   # set once your prod DB exists
# DB_ALLOW_UNSAFE=1                                            # escape hatch; leave unset normally

# ── Database (PostgreSQL — same `pg` connection everywhere; just swap the URL) ─
# Three interchangeable tiers (the app uses only standard Postgres, so any of these is a
# one-line change — see DATABASE_SETUP.md):
#   BUILD/dev   → hosted Supabase free  (Settings → Database → Connection string → URI)
#                 DATABASE_URL=postgresql://postgres:[PW]@db.[ref].supabase.co:5432/postgres
#   HEAVY TEST  → local Postgres (put this in .env.local, NOT here)
#                 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/caishen
#                 (local Supabase CLI uses port 54322)
#   PRODUCTION  → AWS RDS / Aurora PostgreSQL (later)
#                 DATABASE_URL=postgresql://USER:[PW]@xxxx.rds.amazonaws.com:5432/caishen
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth / crypto ────────────────────────────────────────────────────────────
# JWT signing secret — MUST be a long random string in production (code has a dev fallback).
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# AES key that encrypts Plaid access tokens at rest (core/secret.js). Set in prod.
FIELD_ENCRYPTION_KEY=
# Seeds the default admin + optional extra login gate. Leave MASTER_PASSWORD unset to disable.
ADMIN_EMAIL=
MASTER_PASSWORD=

PORT=3001
AUTO_SYNC_INTERVAL=60

# ── File storage: Cloudflare R2 (S3-compatible; bytes live here, metadata in DB) ──
# Use a SEPARATE bucket for dev so local uploads never touch production files
# (e.g. R2_BUCKET=caishen-dev in .env.local, caishen-prod in production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── AI Advisor — model providers ─────────────────────────────────────────────
AI_PROVIDER=ollama                     # 'ollama' | 'groq' | 'anthropic'
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=
GROQ_API_KEY=                          # free tier — https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=
RECEIPT_OCR_PROVIDER=                  # 'groq' | 'anthropic' (defaults: groq if key set, else anthropic)

# ── RAG: Ollama (local embeddings) + Qdrant (vector store) ───────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:32b-instruct
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tax_sources
QDRANT_API_KEY=

# ── Plaid (live bank connections) ────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                      # 'sandbox' for dev, 'production' for prod
PLAID_WEBHOOK_URL=

# ── QuickBooks (optional) ────────────────────────────────────────────────────
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=

# ── Email (2FA codes / notifications) ────────────────────────────────────────
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM=
EMAIL_PASS=

# ── Twilio (SMS chatbot / 2FA, optional) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PUBLIC_URL=                     # public https base so Twilio can reach the inbound webhook

# ── Discord categorizer bot (optional) ───────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# ── Misc ─────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
# DEBUG_AUDIT_CSV=1                     # re-enable the write-only audit CSV snapshots (dev only)
